# Internal URL of the Go API, used by the Next.js server.
API_URL=http://localhost:8080
# Public URL of the API, shown to users as the MCP connector URL (PUBLIC_URL of the API).
API_PUBLIC_URL=http://localhost:8080
# IANA time zone used for "today" and month boundaries (match the API).
APP_TIMEZONE=America/Mexico_City
# Currency preselected when creating the first account.
DEFAULT_CURRENCY=MXN
# Telemetry (optional; see docs/observability.md). Export is off unless set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
