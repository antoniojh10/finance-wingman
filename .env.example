# API
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://finance:finance@localhost:5432/finance?sslmode=disable
# Run pending migrations when the API starts.
MIGRATE_ON_START=true
# IANA time zone used to resolve "today" and monthly summaries.
APP_TIMEZONE=America/Mexico_City
# Public base URL of this API (OAuth issuer; MCP endpoint is PUBLIC_URL/mcp).
PUBLIC_URL=http://localhost:8080
# Public URL of the web app; magic links point here.
WEB_BASE_URL=http://localhost:3000
# Users granted access on startup: "email:Name,email2:Name2". They own the
# first workspace, created when the database has none.
INITIAL_USERS=
# Name of that first workspace (defaults to "Finance Wingman").
# INITIAL_WORKSPACE_NAME=

# Email: log (print to console), smtp, or resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@localhost
# Sign-in emails allowed per user per hour (default 5); raise it for local testing.
# LOGIN_EMAILS_PER_HOUR=5
# Sender display name (defaults to "Finance Wingman"); quote it only outside .env files.
# EMAIL_FROM_NAME=
# Local development uses Mailpit: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=

# Telemetry (optional; see docs/observability.md). Export is off unless an
# OTLP endpoint is set. Locally: `make grafana` and uncomment the next line.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
# Serve net/http/pprof on a separate, private listener.
# PPROF_ADDR=localhost:6060

# Tests
TEST_DATABASE_URL=postgres://finance:finance@localhost:5432/finance_test?sslmode=disable
